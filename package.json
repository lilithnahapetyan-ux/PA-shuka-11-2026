{
  "name": "shuka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/migrate.js",
    "seed": "node scripts/seed.js",
    "check:db": "node scripts/check-db.js",
    "test:auth": "node scripts/test-auth.js",
    "test:catalog": "node scripts/test-catalog.js",
    "test": "node scripts/test-auth.js && node scripts/test-catalog.js && node scripts/test-seller.js && node scripts/test-orders.js",
    "test:seller": "node scripts/test-seller.js",
    "test:orders": "node scripts/test-orders.js",
    "breakit": "node scripts/breakit.js",
    "build": "npm --prefix web install && npm --prefix web run build",
    "local": "npm install && npm run seed && npm run build && npm start",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  }
}
